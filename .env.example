# Only needed for live model calls. Everything else — the demo, the test suite,
# and the eval harness in replay mode — runs without it.
ANTHROPIC_API_KEY=

# Replay/record mode for model calls (ADR-0005).
#   SENTRA_REPLAY=1  serve responses from agents/replay/cassettes, no network
#   SENTRA_RECORD=1  make live calls and write cassettes
#   SENTRA_LIVE=1    force live calls; needed only if you authenticate with an
#                    `ant auth login` profile, which leaves nothing here to detect
#
# Set at most one. Two at once is refused rather than resolved — a silent winner
# is how a stale cassette gets mistaken for a model change.
#
# With none set and no credentials above, replay is the default. That is what
# lets a fresh clone run the pipeline with nothing configured.
SENTRA_REPLAY=
SENTRA_RECORD=
SENTRA_LIVE=

# The model is NOT configured here. It is pinned in agents/model-client.ts, because
# a model change moves every number in eval/report.md and belongs in a reviewable
# commit with an eval run attached — not in someone's local environment, where two
# people would silently publish figures from two different models.

# Hard ceiling on output tokens per pipeline run. When hit, the orchestrator stops
# dispatching and the report says how many failures went unclassified.
SENTRA_TOKEN_BUDGET=200000

# Concurrent agent calls. Read by the orchestrator, which lands in M7 (#66) —
# nothing reads it today.
SENTRA_CONCURRENCY=4

# Confidence above which the root-cause agent runs. Read by that agent, which
# lands in M7 (#64) — nothing reads it today.
#
# Read off the calibration section of eval/report.md, not chosen by hand: it is
# the lowest confidence whose predictions are actually right often enough to be
# worth elaborating on. That section also says when no threshold could be derived
# — and when it says confidence carries no information, the answer is to stop
# gating on it rather than to pick a number that looks reasonable.
SENTRA_ROOT_CAUSE_THRESHOLD=0.7

# Seeded latency injection in the TaskFlow API. Unset means off, and a test
# asserts that. The same seed always produces the same interleaving, so a race
# caught once can be got back — which is what separates emergent flakiness from
# a sleep in a spec.
#
# SENTRA_CHAOS=284549 reproduces the deliberate reorder race in app/client/useTasks.ts.
# The number is ugly because it was measured against the request sequence a browser
# actually makes, in a browser. The seed documented before it was measured against a
# sequence the application does not produce, and it never worked.
SENTRA_CHAOS=

# TaskFlow, the system under test.
#
# SENTRA_DB is the SQLite file the API opens. It defaults to .taskflow/tasks.db
# rather than :memory: — a dev server that forgets everything on restart is a
# worse default than one that keeps a file nobody committed.
PORT=3001
SENTRA_DB=.taskflow/tasks.db
VITE_PORT=5173

# SENTRA_API_URL is where the Vite dev server forwards /api/, and it is
# deliberately not VITE_-prefixed: Vite exposes every VITE_ variable to the
# browser, and the client reads VITE_API_URL to decide whether to fetch
# absolutely. Setting one name for both pointed the proxy at the API and told the
# client to skip the proxy at the same time, which the API has no CORS headers
# for. `npm run dev` did that, so the board never loaded.
SENTRA_API_URL=http://localhost:3001

# VITE_API_URL points a *built* client at an API on another origin. Leave it
# unset for development: unset means relative, which means the proxy, which means
# same-origin.
VITE_API_URL=

# The end-to-end run.
#
# SENTRA_E2E_WORKERS is both the number of Playwright workers and the number of
# TaskFlow instances the launcher starts, because they are the same number: each
# worker gets its own server and its own database. Two everywhere by default, so
# a 28-core laptop and a 2-core runner execute the suite in the same shape.
#
# SENTRA_E2E_PORT is the first of those ports; worker n listens on PORT + n.
#
# SENTRA_E2E_RETRIES is off by default and that is the load-bearing setting in
# the whole configuration. A retry turns a failure into a pass and erases the
# intermittency this project consumes, before anything downstream can see it.
# Raise it for a specific investigation, never in CI.
# SENTRA_E2E_CHAOS is the seed for the second TaskFlow each worker runs, the one
# with latency injection on. Left unset the launcher draws a new seed per run and
# prints it — which is what makes the reorder spec intermittent rather than a
# reproduction that fires every time. Set it to the seed a run printed to get
# that run's interleaving back.
SENTRA_E2E_WORKERS=2
SENTRA_E2E_PORT=4310
SENTRA_E2E_RETRIES=0
SENTRA_E2E_CHAOS=
