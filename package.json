{
  "name": "sentra",
  "version": "0.1.0",
  "private": true,
  "description": "An AI triage layer for CI test failures \u2014 packaged as a pipeline step, not a service.",
  "license": "MIT",
  "author": "Andrii Kohut",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AKogut/ai-flaky-test-triage.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "contracts",
    "prompts",
    "app/client",
    "app/server",
    "flakemetry-lib",
    "agents",
    "eval"
  ],
  "scripts": {
    "agents:analyze": "tsx agents/run.ts",
    "analyze": "node scripts/pending.mjs analyze",
    "build": "npm run build --workspace @sentra/taskflow-client",
    "capture": "tsx scripts/capture.ts",
    "cassettes:check": "tsx scripts/cassettes.ts",
    "cassettes:record": "tsx scripts/record.ts",
    "changelog": "tsx scripts/changelog.ts",
    "changelog:check": "tsx scripts/changelog.ts --check",
    "demo": "tsx scripts/demo.ts",
    "dev": "tsx scripts/dev.ts",
    "docs:status": "tsx scripts/status-banner.ts",
    "docs:status:check": "tsx scripts/status-banner.ts --check",
    "eval": "tsx eval/run-eval.ts",
    "eval:ablation": "node scripts/pending.mjs eval:ablation",
    "eval:lint": "tsx eval/hygiene.ts",
    "flakemetry:analyze": "tsx scripts/analyze.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "help": "node scripts/help.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "prompts:freeze": "tsx prompts/freeze.ts",
    "prompts:sync": "tsx prompts/sync.ts",
    "prompts:sync:check": "tsx prompts/sync.ts --check",
    "test": "npm run test:unit && npm run test:e2e",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "tsx scripts/e2e.ts",
    "test:unit": "vitest run",
    "typecheck": "tsc --build",
    "typecheck:clean": "tsc --build --clean",
    "wiki:publish": "./scripts/publish-wiki.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.9.0",
    "husky": "9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "16.4.0",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "^5.7.2",
    "typescript-eslint": "8.66.0",
    "vite": "^8.2.1",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.116.0",
    "zod": "4.4.3"
  }
}
